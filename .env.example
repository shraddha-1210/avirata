# Copy to .env and fill in real values. Never commit .env.
#
# Tier 2 diagnosis makes a REAL Google Gemini API call on the live/demo path
# only. Every automated pytest run mocks this call (see tests/conftest.py) and
# never touches the network. Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Small structured-output classification task -> the cheapest/fastest Gemini
# tier is sufficient.
TIER2_MODEL=gemini-3.5-flash-lite

# Postgres: powers the pipeline and the Phase 4 idempotency burst test, which
# MUST run against the real UNIQUE constraint. `docker compose up -d db` starts
# a matching throwaway instance.
DATABASE_URL=postgresql+psycopg://avirata:avirata@localhost:5432/avirata

# Shared secret for webhook authenticity. Leave EMPTY to accept every webhook
# (the demo default; the server logs a warning at startup). When set,
# POST /api/events/ingest and POST /api/webhooks/settlement require an
# X-Avirata-Signature header carrying HMAC-SHA256(secret, raw_request_body)
# as lowercase hex.
WEBHOOK_SIGNING_SECRET=
